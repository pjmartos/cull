<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.1"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.1
                              http://maven.apache.org/xsd/assembly-2.1.1.xsd">
    <id>dist</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>cull-${project.version}</baseDirectory>

    <dependencySets>
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <useStrictFiltering>true</useStrictFiltering>
            <includes>
                <include>io.github.pjmartos.cull:cull-extension</include>
                <include>io.github.pjmartos.cull:cull-agent</include>
                <include>io.github.pjmartos.cull:cull-maven-plugin</include>
            </includes>
        </dependencySet>
    </dependencySets>

    <fileSets>
        <fileSet>
            <directory>${project.basedir}/src/templates</directory>
            <outputDirectory>templates</outputDirectory>
            <includes>
                <include>extensions.xml.template</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
